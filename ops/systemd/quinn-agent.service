[Unit]
Description=Quinn agent loop
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=quinn
Group=quinn
EnvironmentFile=/etc/quinn/secrets.env
WorkingDirectory=/opt/quinn/app
ExecStart=/opt/quinn/app/.venv/bin/python -m src.app
Restart=on-failure
RestartSec=10
# Backstop only: graceful shutdown should complete in seconds — the
# SIGTERM handler wakes the idle consumer with a queue sentinel
# (AgentLoop.request_shutdown) and teardown is bounded by the loop's
# own grace window. 120s guards a future wedge before SIGKILL.
TimeoutStopSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quinn /var/log/quinn

[Install]
WantedBy=multi-user.target
