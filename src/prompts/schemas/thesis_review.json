{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThesisReview",
  "type": "object",
  "required": ["decision", "rationale"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["hold", "close", "adjust_stop"]
    },
    "rationale": {
      "type": "string",
      "minLength": 50,
      "maxLength": 4000
    },
    "modifications": {
      "type": "object",
      "description": "Required when decision == 'adjust_stop'. Carries the new stop-loss price in absolute USD.",
      "properties": {
        "new_stop_price": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["new_stop_price"],
      "additionalProperties": false
    }
  }
}
