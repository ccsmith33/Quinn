{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TradeProposal",
  "type": "object",
  "required": [
    "symbol",
    "direction",
    "size_pct_of_capital",
    "entry_style",
    "stop_loss_price",
    "time_horizon_days",
    "conviction",
    "thesis",
    "signals",
    "exit_conditions",
    "risk_factors"
  ],
  "properties": {
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$"
    },
    "direction": {
      "type": "string",
      "enum": ["long"]
    },
    "size_pct_of_capital": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.20
    },
    "entry_style": {
      "type": "string",
      "enum": ["market_open", "limit"]
    },
    "entry_limit_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stop_loss_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "take_profit_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "time_horizon_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "conviction": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "thesis": {
      "type": "string",
      "minLength": 50,
      "maxLength": 4000
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 800
      }
    },
    "exit_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 800
      }
    },
    "risk_factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 800
      }
    },
    "prompt_version": {
      "type": "string",
      "description": "system_injected"
    },
    "source_filings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["accession_number", "filing_type"],
        "properties": {
          "accession_number": { "type": "string" },
          "filing_type": { "type": "string" },
          "item_codes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "description": "system_injected"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "entry_style": { "const": "limit" } } },
      "then": { "required": ["entry_limit_price"] }
    }
  ]
}
