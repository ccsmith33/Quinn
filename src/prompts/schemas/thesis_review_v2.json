{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThesisReview",
  "type": "object",
  "required": ["decision", "rationale"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["hold", "close", "adjust_stop", "adjust_take_profit"]
    },
    "rationale": {
      "type": "string",
      "minLength": 50,
      "maxLength": 4000
    },
    "modifications": {
      "type": "object",
      "description": "Required when decision == 'adjust_stop' (carries new_stop_price) or decision == 'adjust_take_profit' (carries new_tp_price). Prices in absolute USD. Exactly the key matching the decision; never both.",
      "properties": {
        "new_stop_price": { "type": "number", "exclusiveMinimum": 0 },
        "new_tp_price": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "adjust_stop" } } },
      "then": {
        "required": ["modifications"],
        "properties": {
          "modifications": { "required": ["new_stop_price"] }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "adjust_take_profit" } } },
      "then": {
        "required": ["modifications"],
        "properties": {
          "modifications": { "required": ["new_tp_price"] }
        }
      }
    }
  ]
}
