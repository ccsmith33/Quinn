# Quinn — secrets template
#
# Local development:
#   cp .env.example .env
#   # fill in values, then:
#   set -a; source .env; set +a
#
# Production droplet:
#   cp .env.example /etc/quinn/secrets.env
#   chmod 600 /etc/quinn/secrets.env
#   chown root:root /etc/quinn/secrets.env
#   # fill in values; systemd units read this via EnvironmentFile=
#
# .env is in .gitignore — never commit real secrets.

# --- Anthropic API (Sonnet analyzer + Opus reviewer) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Alpaca broker ---
# Paper: https://paper-api.alpaca.markets
# Live:  https://api.alpaca.markets
# Same code path; only the endpoint + creds change (D-007).
ALPACA_API_KEY_ID=PK_REPLACE_ME
ALPACA_API_SECRET_KEY=REPLACE_ME
ALPACA_ENDPOINT=https://paper-api.alpaca.markets

# --- Telegram kill-switch bot (S7.2) ---
# Get token from @BotFather → /newbot
# Get chat ID by DMing your new bot once, then:
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_OPERATOR_CHAT_ID=REPLACE_ME

# --- HMAC webhook fallback (S7.3) ---
# Generate with: openssl rand -hex 32
KILL_SWITCH_HMAC_KEY=REPLACE_ME

# --- Backblaze B2 backup (S8.3) ---
# Free tier: https://www.backblaze.com/b2/
# Create an Application Key scoped to a single bucket.
BACKUP_B2_KEY_ID=REPLACE_ME
BACKUP_B2_APPLICATION_KEY=REPLACE_ME
BACKUP_B2_BUCKET=quinn-backups

# --- Off-box log sink (S8.1) ---
# Better Stack / Logtail token; Vector ships logs here.
LOG_SINK_TOKEN=REPLACE_ME

# --- Operator dashboard (S9.1) ---
# HTTP basic-auth credentials for the read-only dashboard at port 8444 (or
# fronted via Caddy at https://<your-name>.duckdns.org/). Constant-time
# compare via `secrets.compare_digest` — see src/dashboard/auth.py.
# Generate the password with:
#   openssl rand -hex 16
DASHBOARD_USER=operator
DASHBOARD_PASSWORD=REPLACE_ME

# --- Optional: DuckDNS auto-DNS for the dashboard (S9.1) ---
# Sign up at https://www.duckdns.org/ — pick a subdomain, copy your token
# from the dashboard. Leave both blank if running LAN-only.
# `ops/duckdns/update.sh` is the 5-minute-cron updater script; install
# the cron entry as documented in that script's header.
DUCKDNS_TOKEN=
DUCKDNS_DOMAIN=

# --- Optional ---
# Email for daily report + alert escalation (in addition to Telegram)
OPERATOR_NOTIFY_EMAIL=
